#!/usr/bin/env bash
# light the moonlander backlight through kontroll + keymapp (api enabled in
# keymapp's config page). silent no-op when either is missing, and returns
# immediately so callers (claude code hooks) never wait on the keyboard.
#
# each claude session keeps its own state (keyed by the hook payload's
# session_id); the board shows the most urgent across all of them:
# any waiting -> amber, else any finished -> green, else oryx colours.
#
# usage: kbd-signal attention|done|reset   (hook json on stdin, optional)
set -uo pipefail

case "${1:-}" in
  attention | done | reset) state="$1" ;;
  *) echo "usage: kbd-signal attention|done|reset" >&2; exit 1 ;;
esac

# linux builds kontroll with cargo; hooks may run with a PATH that predates it
PATH="$HOME/.cargo/bin:$PATH"
command -v kontroll >/dev/null 2>&1 || exit 0

# keymapp only listens while running; skip the kontroll timeout otherwise
sockets=(
  "${XDG_CONFIG_HOME:-$HOME/.config}/.keymapp/keymapp.sock"
  "$HOME/Library/Application Support/.keymapp/keymapp.sock"
  "$HOME/Library/Containers/io.zsa.keymapp/Data/Library/Application Support/.keymapp/keymapp.sock"
)
found=false
for sock in "${sockets[@]}"; do
  [[ -S "$sock" ]] && found=true && break
done
[[ "$found" == "true" ]] || exit 0

session="manual"
if [[ ! -t 0 ]] && command -v jq >/dev/null 2>&1; then
  session=$(jq -r '.session_id // empty' 2>/dev/null)
  session="${session:-manual}"
fi

state_dir="${XDG_RUNTIME_DIR:-${TMPDIR:-/tmp}}/kbd-signal"
mkdir -p "$state_dir"

update() {
  if [[ "$state" == "reset" ]]; then
    rm -f "$state_dir/$session"
  else
    echo "$state" >"$state_dir/$session"
  fi

  # sessions that died without SessionEnd shouldn't pin the light forever
  find "$state_dir" -type f -mmin +720 -delete 2>/dev/null

  local color=""
  if grep -qsx 'attention' "$state_dir"/*; then
    color="#ff8800"
  elif grep -qsx 'done' "$state_dir"/*; then
    color="#00cc44"
  fi

  send() {
    if [[ -n "$color" ]]; then
      kontroll set-rgb-all --color "$color"
    else
      kontroll restore-rgb-leds
    fi
  }
  # keymapp may not have picked a keyboard yet; connect once and retry
  send || { kontroll connect-any && send; }
}

# serialise so overlapping hooks from several sessions can't reorder colours
# (flock is linux-only; without it the last writer still wins)
(
  if command -v flock >/dev/null 2>&1; then
    flock -w 5 9 || exit 0
  fi
  update
) 9>"$state_dir/.lock" >/dev/null 2>&1 &
disown
exit 0
