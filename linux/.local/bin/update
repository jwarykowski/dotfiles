#!/usr/bin/env bash
set -euo pipefail

log() { echo "==> $*"; }
failed=()
# run a step, keep going on failure, report at the end
step() {
  local name="$1"
  shift
  log "$name..."
  "$@" || failed+=("$name")
}
has() { command -v "$1" >/dev/null 2>&1; }

step "dnf upgrade" sudo dnf upgrade -y

has flatpak && step "flatpak update" flatpak update -y
has rustup && step "rustup" rustup update
has mise && step "mise" mise upgrade
has herdr && step "herdr" herdr update

step "zsh plugins" zsh -ic 'znap pull'
step "nvim plugins" nvim --headless "+Lazy! sync" "+MasonUpdate" +qa

has cargo-install-update && step "cargo packages" cargo install-update -a

if ((${#failed[@]})); then
  log "failed: ${failed[*]}"
  exit 1
fi
log "done"
