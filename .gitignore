# repo-local runtime files (this .gitignore governs the dotfiles repo itself;
# the global excludes file is common/.config/git/ignore)
.claude/scheduled_tasks.lock
.DS_Store

# shepherd data (config.toml is tracked, boards and todos are not)
common/.config/shepherd/todo.md
common/.config/shepherd/archive.md
common/.config/shepherd/boards.toml
common/.config/shepherd/boards/
*.md.lock

# gh rewrites this in place through the stow symlink and can write an
# oauth_token into it
common/.config/gh/hosts.yml

# npm credentials live in ~/.npmrc, never in the repo
common/.npmrc

# herdr runtime state (~/.config/herdr is a folded stow symlink into the repo);
# config.toml and herdr-plus project templates are tracked
common/.config/herdr/*
!common/.config/herdr/config.toml
!common/.config/herdr/plugins/
common/.config/herdr/plugins/*
!common/.config/herdr/plugins/config/
common/.config/herdr/plugins/config/*
!common/.config/herdr/plugins/config/cloudmanic.herdr-plus/
common/.config/herdr/plugins/config/cloudmanic.herdr-plus/*
!common/.config/herdr/plugins/config/cloudmanic.herdr-plus/projects/
