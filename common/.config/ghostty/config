shell-integration = zsh
theme = lackluster

cursor-style = bar
cursor-style-blink = false
font-family = Berkeley Mono
shell-integration-features = "no-cursor,sudo,ssh-env,ssh-terminfo"

window-padding-x = 8
window-padding-y = 8

# per-platform settings (font size, clipboard, macos-*), loaded after this file
config-file = ?config.local
