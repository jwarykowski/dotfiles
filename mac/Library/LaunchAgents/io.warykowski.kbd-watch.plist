<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- light the moonlander from herdr agent status (see ~/.local/bin/kbd-watch);
     launchd doesn't expand ~ or $HOME in arguments, so go through sh -->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>io.warykowski.kbd-watch</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/sh</string>
    <string>-c</string>
    <string>exec "$HOME/.local/bin/kbd-watch" run</string>
  </array>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>ThrottleInterval</key>
  <integer>10</integer>
</dict>
</plist>
