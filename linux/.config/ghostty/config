shell-integration = zsh
theme = lackluster

cursor-style = bar
cursor-style-blink = false
font-family = Berkeley Mono
font-size = 14
shell-integration-features = "no-cursor,ssh-env,ssh-terminfo"

copy-on-select = primary
window-padding-x = 8
window-padding-y = 8

keybind = global:unconsumed:ctrl+shift+r=reload_config
