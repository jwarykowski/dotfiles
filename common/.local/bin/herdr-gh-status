#!/usr/bin/env bash
# report each herdr workspace's pull request to the sidebar as $gh, e.g.
#   #412│×│!    #412 (d412 = draft)  ci √ passed × failed • running
#               review + approved ! changes requested (blank while waiting)
#   #412│↗      merged (time to remove the worktree)   #412│† closed
# symbols are ones berkeley mono has, so nothing falls back to another font
# values expire after a few missed polls, so a stopped reporter leaves no
# stale state behind. also marks shepherd todos handed out by
# herdr-todo-agent done once their branch's pull request merges.
#
# usage: herdr-gh-status run    poll every minute
#        herdr-gh-status once   report once and exit
set -uo pipefail

# services start with a minimal PATH: herdr/gh/jq may live in ~/.local/bin
# or homebrew
PATH="$HOME/.local/bin:/opt/homebrew/bin:$PATH"

interval=60
ttl_ms=$((interval * 3 * 1000))

# the $gh value for the branch checked out in $1, or nothing without a PR
pr_status() {
  (cd "$1" && gh pr view --json number,state,isDraft,reviewDecision,statusCheckRollup 2>/dev/null) |
    jq -r '
      def ci:
        if length == 0 then ""
        elif any(.[]; (.conclusion // .state // "")
                      | test("FAILURE|ERROR|CANCELLED|TIMED_OUT|ACTION_REQUIRED")) then "×"
        elif any(.[]; (.status // "COMPLETED") != "COMPLETED"
                      or ((.state // "") | test("PENDING|EXPECTED"))) then "•"
        else "√" end;
      ((if .isDraft then "d" else "#" end) + (.number | tostring)) as $number
      | if .state == "MERGED" then [$number, "↗"]
        elif .state == "CLOSED" then [$number, "†"]
        else [ $number,
               (.statusCheckRollup // [] | ci),
               ({"APPROVED": "+", "CHANGES_REQUESTED": "!"}[.reviewDecision // ""] // "") ]
        end
      | map(select(. != "")) | join("│")'
}

# todos herdr-todo-agent handed to an agent: done once the branch merges
complete_merged_todos() {
  local state_dir="${XDG_STATE_HOME:-$HOME/.local/state}/herdr-todo-agent"
  local file board id repo branch
  for file in "$state_dir"/*; do
    [[ -f "$file" ]] || continue
    IFS=$'\t' read -r board id repo <"$file"
    branch=$(basename "$file")
    branch="${branch//__//}"
    if [[ "$(cd "$repo" 2>/dev/null && gh pr view "$branch" --json state -q .state 2>/dev/null)" == "MERGED" ]]; then
      shepherd 'done' "$id" --board "$board" -q && rm -f "$file"
    fi
  done
}

once() {
  gh auth status >/dev/null 2>&1 || return 0
  complete_merged_todos
  local id cwd value
  # one line per workspace: id and the cwd of its first pane
  herdr api snapshot 2>/dev/null | jq -r '
    .result.snapshot as $s
    | $s.workspaces[]
    | .workspace_id as $w
    | [$w, ([$s.panes[] | select(.workspace_id == $w) | .cwd] | first // "")]
    | @tsv' |
    while IFS=$'\t' read -r id cwd; do
      value=""
      if [[ -n "$cwd" ]] && git -C "$cwd" rev-parse --is-inside-work-tree >/dev/null 2>&1; then
        value=$(pr_status "$cwd")
      fi
      if [[ -n "$value" ]]; then
        # herdr only parses the options after the workspace id
        herdr workspace report-metadata "$id" --source gh-status --ttl-ms "$ttl_ms" \
          --token "gh=$value" >/dev/null 2>&1
      else
        herdr workspace report-metadata "$id" --source gh-status --clear-token gh >/dev/null 2>&1
      fi
    done
}

case "${1:-}" in
  once) once ;;
  run)
    while true; do
      once
      sleep "$interval"
    done
    ;;
  *) echo "usage: herdr-gh-status run|once" >&2; exit 1 ;;
esac
