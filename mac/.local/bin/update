#!/usr/bin/env bash
set -euo pipefail

log() { echo "==> $*"; }
failed=()
# run a step, keep going on failure, report at the end
step() {
  local name="$1"
  shift
  log "$name..."
  "$@" || failed+=("$name")
}
has() { command -v "$1" >/dev/null 2>&1; }

step "brew upgrade" brew upgrade
step "brew cask upgrade" brew upgrade --cask --greedy

has rustup && step "rustup" rustup update
has bun && step "bun" bun upgrade

step "zsh plugins" zsh -ic 'znap pull'
step "nvim plugins" nvim --headless "+Lazy! sync" "+MasonUpdate" +qa
step "tmux plugins" "$HOME/.tmux/plugins/tpm/bin/update_plugins" all

has cargo-install-update && step "cargo packages" cargo install-update -a
step "npm globals" npm update -g

if ((${#failed[@]})); then
  log "failed: ${failed[*]}"
  exit 1
fi
log "done"
