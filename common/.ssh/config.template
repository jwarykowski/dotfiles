# SSH client config template
# Copy to ~/.ssh/config and customize

# per-host snippets, kept out of this file (must precede any Host block)
Include ~/.ssh/config.d/*

Host *
    ServerAliveInterval 60
    ServerAliveCountMax 3
    AddKeysToAgent yes
    IdentityFile ~/.ssh/id_ed25519
    IdentitiesOnly yes

# Host alias-name
#     HostName hostname.example.com
#     User username
#     Port 22
#     IdentityFile ~/.ssh/id_ed25519
