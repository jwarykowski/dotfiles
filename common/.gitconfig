[user]
  email = jonathan@warykowski.io
  name = Jonathan Warykowski
  signingKey = F21DC55BCB19C299

# work identity, keyed off the remote rather than a directory (repos are mixed
# together under ~/development)
[includeIf "hasconfig:remote.*.url:git@github.com:zeller-engineering/**"]
  path = ~/.gitconfig-work

[branch]
  sort = committerdate

[checkout]
  defaultRemote = origin

[commit]
  gpgsign = true
  template = ~/.git-commit-template
  verbose = true

[core]
  editor = nvim
  excludesfile = ~/.gitignore
  ignorecase = false
  pager = delta

[interactive]
  diffFilter = delta --color-only

[delta]
  navigate = true
  dark = true
  line-numbers = true
  hyperlinks = true
  syntax-theme = ansi
  blame-code-style = syntax
  features = wide

# side-by-side lives in a feature so lazygit can turn it off via --features
[delta "wide"]
  side-by-side = true

[delta "lazygit"]
  side-by-side = false

[diff]
  algorithm = histogram
  colorMoved = default

[help]
  autocorrect = prompt

[merge]
  conflictstyle = zdiff3

[pull]
  rebase = true

[push]
  autoSetupRemote = true

[status]
  showUntrackedFiles = all

[transfer]
  fsckobjects = true

[tag]
  gpgSign = true

[rebase]
  updateRefs = true

[fetch]
  prune = true

[init]
  defaultBranch = master
