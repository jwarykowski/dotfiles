# repo-local runtime files (this .gitignore governs the dotfiles repo itself;
# the global excludes file is common/.config/git/ignore)
.claude/scheduled_tasks.lock
.DS_Store

# credential guards: with --no-folding apps write these to $HOME, not the
# repo, but a machine still on folded stow links (pre unfold-stow.sh) can
# leak gh's oauth_token or npm auth into a commit
common/.config/gh/hosts.yml
common/.npmrc
