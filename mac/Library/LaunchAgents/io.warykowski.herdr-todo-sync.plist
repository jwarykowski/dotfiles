<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- complete shepherd todos whose agent branch merged (see
     ~/.local/bin/herdr-todo-sync); launchd doesn't expand $HOME, so use sh -->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>io.warykowski.herdr-todo-sync</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/sh</string>
    <string>-c</string>
    <string>exec "$HOME/.local/bin/herdr-todo-sync" run</string>
  </array>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>ThrottleInterval</key>
  <integer>30</integer>
</dict>
</plist>
